# Copy to .env. Keep .env private; never paste its contents into chat or logs.
NILA_ENV=development
# Generate with: .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
NILA_SECRET_KEY=

# Nila uses MySQL only. Fill these in after creating a dedicated database/user.
NILA_DB_HOST=127.0.0.1
NILA_DB_PORT=3306
NILA_DB_NAME=nila
NILA_DB_USER=
NILA_DB_PASSWORD=

